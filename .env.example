# Copy this file to .env and fill in real values. Never commit .env.

# LLM provider settings (Phase 5). Leave LLM_API_KEY empty to run without answer generation.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Upload limits
MAX_UPLOAD_MB=10

# Chunking defaults
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
TOP_K=4
MIN_SIMILARITY=0.25

# Embedding model (Phase 4)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local storage for uploads and indexes
DATA_DIR=data

LLM_API_KEY = 